# Cloudflare static assets: headers for every page and file. The CSP itself is in each page's <meta>;
# frame-ancestors only works as a header, so no other site can put Motus (sign-in, delete account) in a frame.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Temporary (owner's first install of the Motus Shortcut; removed once it is shared as an iCloud link)
/setup/motus-shortcut-signing.mobileconfig
  Content-Type: application/x-apple-aspen-config
/setup/Motus.shortcut
  Content-Type: application/octet-stream
  Content-Disposition: attachment; filename="Motus.shortcut"
